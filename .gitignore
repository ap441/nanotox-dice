# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Jupyter Notebooks
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Data files (raw CSV / XLSX / tabular data)
data/raw/*.csv
data/raw/*.tsv
data/raw/*.xlsx
data/raw/*.xls
*.csv
*.tsv
*.xlsx
*.xls

# Never ignore .gitkeep files in data or results
!**/data/**/.gitkeep
!**/results/**/.gitkeep
!**/models/**/.gitkeep
!**/.gitkeep

# Track results tables
!results/tables/*.csv

# Model weights / serialized artifacts
*.pkl
*.joblib
models/*.joblib
*.pt
*.pth
*.onnx

# Training runs / temporary metrics
catboost_info/

# Environment variables & secrets
.env
.env.*
!.env.example

# IDE & OS metadata
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
